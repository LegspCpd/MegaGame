# ============================================================================
# MULTI-STAGE DOCKER BUILD - Optimized for size and security
# ============================================================================

# ---- Builder Stage ----
FROM golang:1.23-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    protoc \
    ca-certificates \
    tzdata \
    && update-ca-certificates

# Create non-root user for build
RUN adduser -D -g '' appbuilder

WORKDIR /build

# Copy go modules first (for layer caching). go.sum is generated by CI, so it
# may be absent on a fresh checkout.
COPY --chown=appbuilder:appbuilder server/go.mod ./
RUN go mod download

# Install the protoc plugins at the pinned versions the CI pipeline uses.
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.35.1 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1

# Copy source, including the .proto files needed for generation.
COPY --chown=appbuilder:appbuilder server/ ./server/
COPY --chown=appbuilder:appbuilder shared/ ./shared/

# Generate protos
RUN apk add --no-cache bash \
    && sh shared/proto/build_proto.sh \
    && cp server/go.sum ./go.sum

# Build with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w -buildid= -extldflags '-static' -X main.version=${VERSION:-dev} -X main.commit=${COMMIT:-unknown} -X main.date=${BUILD_DATE:-unknown}" \
    -o /megame-server ./server/cmd/server

# ---- Security Scan Stage ----
FROM aquasec/trivy:latest AS security-scan
COPY --from=builder /megame-server /megame-server
RUN trivy fs --exit-code 1 --severity HIGH,CRITICAL /megame-server

# ---- Runtime Stage ----
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

# Copy binary from builder
COPY --from=builder /megame-server /megame-server

# Copy timezone data
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Use non-root user (UID 65532 from distroless)
USER 65532:65532

# Expose gRPC port
EXPOSE 50051

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/megame-server", "-health-check"]

# Entry point
ENTRYPOINT ["/megame-server"]
CMD ["-port=50051", "-tick-rate=60"]

# ---- Debug Variant (for development) ----
FROM alpine:3.19 AS debug

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    netcat-openbsd \
    busybox-extras \
    && adduser -D -g '' appuser

WORKDIR /app
COPY --from=builder /megame-server .

USER appuser
EXPOSE 50051
ENTRYPOINT ["./megame-server"]
CMD ["-port=50051", "-tick-rate=60", "-log-level=debug"]